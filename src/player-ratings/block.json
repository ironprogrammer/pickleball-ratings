{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pickleball-ratings/player-ratings",
	"version": "1.0.1",
	"title": "Pickleball Player Ratings",
	"category": "widgets",
	"description": "Display a pickleball player's doubles and singles ratings.",
	"keywords": [
		"pickleball",
		"ratings",
		"player"
	],
	"textdomain": "pickleball-ratings",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./frontend.js",
	"render": "file:./render.php",
	"supports": {
		"html": false,
		"align": true,
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"styles": [
		{
			"name": "gradient",
			"label": "Gradient",
			"isDefault": true
		},
		{
			"name": "white",
			"label": "White"
		},
		{
			"name": "black",
			"label": "Black"
		}
	],
	"attributes": {
		"name": {
			"type": "string",
			"default": ""
		},
		"doublesRating": {
			"type": "string",
			"default": ""
		},
		"doublesReliability": {
			"type": "integer"
		},
		"singlesRating": {
			"type": "string",
			"default": ""
		},
		"singlesReliability": {
			"type": "integer"
		},
		"duprId": {
			"type": "string",
			"default": ""
		},
		"mediaId": {
			"type": "integer"
		},
		"updated": {
			"type": "string",
			"default": ""
		}
	},
	"example": {
		"attributes": {
			"name": "Alex Rivera",
			"doublesRating": "4.125",
			"doublesReliability": 85,
			"singlesRating": "3.950",
			"singlesReliability": 60
		}
	}
}
